{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/public/(.*)", "dest": "/public/$1" },
    { "src": "/styles.css", "dest": "/styles.css" },
    { "src": "/leaderboard", "dest": "/leaderboard" },
    { "src": "/player/(.*)", "dest": "/player/$1" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
